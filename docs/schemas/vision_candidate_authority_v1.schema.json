{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betguard.local/schemas/vision-candidate-authority-v1.json",
  "title": "Betguard Vision Candidate Authority V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "revision", "state_at_creation",
    "game", "source", "authority", "active_bets", "cancelled_audit",
    "previous_revision_hash", "canonical_content_hash", "created_at", "safety"
  ],
  "properties": {
    "schema_version": {"const": "vision-candidate-authority-v1"},
    "candidate_id": {"type": "string", "pattern": "^vc-[a-f0-9]{32}$"},
    "revision": {"type": "integer", "minimum": 1},
    "state_at_creation": {"const": "CURRENT"},
    "game": {"type": "string", "minLength": 1},
    "previous_revision_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "source": {"$ref": "#/$defs/source"},
    "authority": {"$ref": "#/$defs/authority"},
    "active_bets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/activeBet"}
    },
    "cancelled_audit": {
      "type": "array",
      "items": {"$ref": "#/$defs/cancelledBet"}
    },
    "canonical_content_hash": {"$ref": "#/$defs/hash"},
    "created_at": {"type": "string", "format": "date-time"},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "humanBetId": {"type": "string", "pattern": "^H-[0-9]{3,}$"},
    "number": {"type": "string", "pattern": "^[0-9]{2}$"},
    "numberGroups": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/number"}
      }
    },
    "multiplier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_rules", "scope", "resolved"],
      "properties": {
        "ordered_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scope": {"type": ["string", "null"]},
        "resolved": {"type": "boolean"}
      }
    },
    "specialPlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw_text", "scope", "resolved"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "raw_text": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]},
        "resolved": {"type": "boolean"}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "resolved"],
      "properties": {
        "present": {"type": "boolean"},
        "resolved": {"type": "boolean"}
      }
    },
    "betProperties": {
      "type": "object",
      "properties": {
        "human_bet_id": {"$ref": "#/$defs/humanBetId"},
        "bet_type": {"type": "string", "minLength": 1},
        "number_groups": {"$ref": "#/$defs/numberGroups"},
        "multiplier": {"$ref": "#/$defs/multiplier"},
        "special_play": {"$ref": "#/$defs/specialPlay"},
        "continuation": {"$ref": "#/$defs/continuation"},
        "cancelled": {"type": "boolean"},
        "active": {"type": "boolean"},
        "executable": {"type": "boolean"},
        "value_authority": {"const": "human_answer"}
      }
    },
    "activeBet": {
      "allOf": [
        {"$ref": "#/$defs/betProperties"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_bet_id", "bet_type", "number_groups", "multiplier",
            "special_play", "continuation", "cancelled", "active",
            "executable", "value_authority"
          ],
          "properties": {
            "human_bet_id": {"$ref": "#/$defs/humanBetId"},
            "bet_type": {"enum": ["normal", "column"]},
            "number_groups": {"$ref": "#/$defs/numberGroups"},
            "multiplier": {"$ref": "#/$defs/multiplier"},
            "special_play": {"$ref": "#/$defs/specialPlay"},
            "continuation": {"$ref": "#/$defs/continuation"},
            "cancelled": {"const": false},
            "active": {"const": true},
            "executable": {"const": true},
            "value_authority": {"const": "human_answer"}
          },
          "allOf": [
            {
              "if": {"properties": {"bet_type": {"const": "normal"}}},
              "then": {"properties": {"number_groups": {"minItems": 1, "maxItems": 1}}}
            },
            {
              "if": {"properties": {"bet_type": {"const": "column"}}},
              "then": {"properties": {"number_groups": {"minItems": 2}}}
            },
            {"properties": {"multiplier": {"properties": {"resolved": {"const": true}, "ordered_rules": {"minItems": 1}}, "minProperties": 3}}},
            {"properties": {"special_play": {"properties": {"resolved": {"const": true}}, "minProperties": 4}}},
            {"properties": {"continuation": {"properties": {"resolved": {"const": true}}, "minProperties": 2}}}
          ]
        }
      ]
    },
    "cancelledBet": {
      "allOf": [
        {"$ref": "#/$defs/betProperties"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_bet_id", "bet_type", "number_groups", "multiplier",
            "special_play", "continuation", "cancelled", "active",
            "executable", "value_authority"
          ],
          "properties": {
            "human_bet_id": {"$ref": "#/$defs/humanBetId"},
            "bet_type": {"type": "string", "minLength": 1},
            "number_groups": {"$ref": "#/$defs/numberGroups"},
            "multiplier": {"$ref": "#/$defs/multiplier"},
            "special_play": {"$ref": "#/$defs/specialPlay"},
            "continuation": {"$ref": "#/$defs/continuation"},
            "cancelled": {"const": true},
            "active": {"const": false},
            "executable": {"const": false},
            "value_authority": {"const": "human_answer"}
          }
        }
      ]
    },
    "machineEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "evidence_hash", "value_authority"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "request_id": {"type": ["string", "null"]},
        "cache_hit": {"type": ["boolean", "null"]},
        "evidence_hash": {"$ref": "#/$defs/hash"},
        "artifact_ref": {"type": ["string", "null"]},
        "value_authority": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_session_id", "human_answer_revision", "human_answer_hash",
        "source_image_id", "source_image_hash"
      ],
      "properties": {
        "review_session_id": {"type": "string", "minLength": 1},
        "human_answer_revision": {"type": "integer", "minimum": 1},
        "human_answer_hash": {"$ref": "#/$defs/hash"},
        "source_image_id": {"type": "string", "minLength": 1},
        "source_image_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_authority", "confirmed_by", "confirmed_at", "all_active_confirmed",
        "blocking_unresolved_count", "machine_evidence_refs"
      ],
      "properties": {
        "value_authority": {"const": "human_answer"},
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "all_active_confirmed": {"const": true},
        "blocking_unresolved_count": {"const": 0},
        "machine_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/machineEvidenceRef"}}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only", "approved_for_fill", "queue_written", "auto_confirm",
        "auto_submit", "webfill_called"
      ],
      "properties": {
        "candidate_only": {"const": true},
        "approved_for_fill": {"const": false},
        "queue_written": {"const": false},
        "auto_confirm": {"const": false},
        "auto_submit": {"const": false},
        "webfill_called": {"const": false}
      }
    }
  }
}
