{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betguard.local/schemas/vision-webfill-mapping-preview-lifecycle-event-v1.json",
  "title": "Betguard Webfill Mapping Preview Lifecycle Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "mapping_preview_id", "event_sequence",
    "event_type", "occurred_at", "actor", "reason_code", "upstream_state",
    "mapping_content_hash", "preview_record_integrity_hash", "event_integrity_hash"
  ],
  "properties": {
    "schema_version": {"const": "vision-webfill-mapping-preview-lifecycle-event-v1"},
    "event_id": {"type": "string", "pattern": "^vwmpe-[a-f0-9]{32}$"},
    "mapping_preview_id": {"type": "string", "pattern": "^vwmp-[a-f0-9]{32}$"},
    "event_sequence": {"type": "integer", "minimum": 1},
    "event_type": {
      "enum": ["PREVIEWED", "AUTHORITY_BLOCKED", "EXPIRED", "OBSERVATION_STALE", "SUPERSEDED", "INVALIDATED", "REVOKED"]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "reason_code": {"type": ["string", "null"], "minLength": 1},
    "upstream_state": {"type": ["string", "null"], "minLength": 1},
    "mapping_content_hash": {"$ref": "#/$defs/hash"},
    "preview_record_integrity_hash": {"$ref": "#/$defs/hash"},
    "event_integrity_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "PREVIEWED"}}},
      "then": {"properties": {"event_sequence": {"const": 1}, "reason_code": {"type": "null"}, "upstream_state": {"type": "null"}}}
    },
    {
      "if": {"properties": {"event_type": {"enum": ["AUTHORITY_BLOCKED", "EXPIRED", "OBSERVATION_STALE", "SUPERSEDED", "INVALIDATED", "REVOKED"]}}},
      "then": {"properties": {"event_sequence": {"const": 2}, "reason_code": {"type": "string", "minLength": 1}, "upstream_state": {"type": "string", "minLength": 1}}}
    }
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
