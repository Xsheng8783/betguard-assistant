{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betguard.local/schemas/vision-webfill-target-profile-v1.json",
  "title": "Betguard Webfill Target Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_profile_id",
    "target_profile_version",
    "game",
    "capabilities",
    "ordering_contract",
    "adapter_boundary",
    "created_at",
    "profile_integrity_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "vision-webfill-target-profile-v1"
    },
    "target_profile_id": {
      "$ref": "#/$defs/targetProfileId"
    },
    "target_profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "game": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "ordering_contract": {
      "$ref": "#/$defs/orderingContract"
    },
    "adapter_boundary": {
      "$ref": "#/$defs/adapterBoundary"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_integrity_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetProfileId": {
      "type": "string",
      "pattern": "^wtp-[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_bet_types",
        "supported_special_play_kinds",
        "supports_continuation",
        "supports_multiple_multiplier_rules",
        "maximum_active_bets",
        "maximum_number_groups_per_bet",
        "maximum_numbers_per_group"
      ],
      "properties": {
        "supported_bet_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["normal", "column"]
          }
        },
        "supported_special_play_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supports_continuation": {
          "type": "boolean"
        },
        "supports_multiple_multiplier_rules": {
          "type": "boolean"
        },
        "maximum_active_bets": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_number_groups_per_bet": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_numbers_per_group": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "orderingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bet_order",
        "group_order",
        "number_order",
        "multiplier_rule_order"
      ],
      "properties": {
        "bet_order": {
          "const": "preserve_candidate_active_bets"
        },
        "group_order": {
          "const": "preserve"
        },
        "number_order": {
          "const": "preserve"
        },
        "multiplier_rule_order": {
          "const": "preserve"
        }
      }
    },
    "adapterBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_contract_only",
        "dom_mapping_present",
        "browser_execution_authorized",
        "submit_authorized"
      ],
      "properties": {
        "logical_contract_only": {
          "const": true
        },
        "dom_mapping_present": {
          "const": false
        },
        "browser_execution_authorized": {
          "const": false
        },
        "submit_authorized": {
          "const": false
        }
      }
    }
  }
}
