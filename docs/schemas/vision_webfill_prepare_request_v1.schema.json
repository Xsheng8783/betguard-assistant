{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betguard.local/schemas/vision-webfill-prepare-request-v1.json",
  "title": "Betguard Webfill Prepare Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_entry_id",
    "claim_id",
    "claim_session_id",
    "claim_generation",
    "fencing_token",
    "expected_candidate_id",
    "expected_canonical_content_hash",
    "expected_queue_revision",
    "target_profile_id",
    "target_profile_version",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "vision-webfill-prepare-request-v1"
    },
    "queue_entry_id": {
      "type": "string",
      "pattern": "^vcq-[a-f0-9]{32}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^vqc-[a-f0-9]{32}$"
    },
    "claim_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "claim_generation": {
      "type": "integer",
      "minimum": 1
    },
    "fencing_token": {
      "type": "string",
      "pattern": "^vqf-[a-f0-9]{64}$"
    },
    "expected_candidate_id": {
      "type": "string",
      "pattern": "^vc-[a-f0-9]{32}$"
    },
    "expected_canonical_content_hash": {
      "$ref": "#/$defs/hash"
    },
    "expected_queue_revision": {
      "type": "integer",
      "minimum": 1
    },
    "target_profile_id": {
      "$ref": "#/$defs/targetProfileId"
    },
    "target_profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^wpi-[a-f0-9]{32,128}$"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetProfileId": {
      "type": "string",
      "pattern": "^wtp-[a-z0-9][a-z0-9._-]{2,63}$"
    }
  }
}
